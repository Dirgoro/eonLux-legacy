#!/usr/bin/env bash
set -euo pipefail

lb config noauto \
  --mode debian \
  --architectures amd64 \
  --distribution trixie \
  --linux-flavours "amd64" \
  --linux-packages "linux-image" \
  --debian-installer none \
  --archive-areas "main contrib non-free non-free-firmware" \
  --parent-mirror-bootstrap "http://deb.debian.org/debian/" \
  --parent-mirror-chroot "http://deb.debian.org/debian/" \
  --parent-mirror-chroot-security "http://security.debian.org/debian-security" \
  --parent-mirror-binary "http://deb.debian.org/debian/" \
  --parent-mirror-binary-security "http://security.debian.org/debian-security" \
  --updates true \
  --security true \
  --bootloader "grub-pc" \
  --binary-images iso-hybrid \
  --iso-application "EonLux Legacy" \
  --iso-preparer "EonLux Project (https://github.com/Dirgoro/eonLux-legacy)" \
  --iso-publisher "EonLux Legacy" \
  --iso-volume "EONLUX_LEGACY" \
  --memtest none \
  --apt-indices true \
  --apt-recommends true \
  --bootappend-live "boot=live components locales=pt_BR.UTF-8 keyboard-layouts=br quiet splash" \
  "${@}"
